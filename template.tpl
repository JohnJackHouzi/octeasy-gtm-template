___SANDBOXED_JS_FOR_WEB_TEMPLATE___

// Octeasy Reading Comfort: loads https://octeasy.com/widget.js with the site key.
// The widget reads the key from window.OcteasyConfig.site, because injectScript
// cannot add a data-site attribute to the script tag. With a valid key, the
// widget then fetches the site's settings from https://octeasy.com/api/v1/config/<key>.
const injectScript = require('injectScript');
const makeString = require('makeString');
const setInWindow = require('setInWindow');

const WIDGET_URL = 'https://octeasy.com/widget.js';
const KEY_CHARS = 'abcdefghijklmnopqrstuvwxyz0123456789';

// Same rule as the widget and the other Octeasy connectors: ^ot_[a-z0-9]{6,32}$
// (the field validator does not run on values that come from a variable).
function isValidKey(key) {
  if (key.length < 9 || key.length > 35 || key.substring(0, 3) !== 'ot_') {
    return false;
  }
  for (let i = 3; i < key.length; i++) {
    if (KEY_CHARS.indexOf(key.charAt(i)) === -1) {
      return false;
    }
  }
  return true;
}

const siteKey = data.siteKey ? makeString(data.siteKey) : '';

if (isValidKey(siteKey)) {
  // Overwrites any OcteasyConfig left on the page: with a key, the settings
  // saved in the Octeasy dashboard take precedence anyway.
  setInWindow('OcteasyConfig', {site: siteKey}, true);
  // The cache token keeps a single script tag if the tag fires more than once.
  injectScript(WIDGET_URL, data.gtmOnSuccess, data.gtmOnFailure, 'octeasy');
} else {
  data.gtmOnFailure();
}


