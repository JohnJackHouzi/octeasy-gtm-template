___TESTS___

scenarios:
- name: Valid key sets OcteasyConfig then loads the widget script
  code: |-
    const calls = [];
    mock('setInWindow', function(key, value, overrideExisting) {
      calls.push(['setInWindow', key, value, overrideExisting]);
      return true;
    });
    mock('injectScript', function(url, onSuccess, onFailure, cacheToken) {
      calls.push(['injectScript', url, cacheToken]);
      onSuccess();
    });

    runCode({siteKey: 'ot_ab12cd34'});

    assertThat(calls).isEqualTo([
      ['setInWindow', 'OcteasyConfig', {site: 'ot_ab12cd34'}, true],
      ['injectScript', 'https://octeasy.com/widget.js', 'octeasy']
    ]);
    assertApi('gtmOnSuccess').wasCalled();
    assertApi('gtmOnFailure').wasNotCalled();
- name: Shortest and longest keys are accepted
  code: |-
    const urls = [];
    mock('injectScript', function(url, onSuccess, onFailure, cacheToken) {
      urls.push(url);
      onSuccess();
    });

    runCode({siteKey: 'ot_a1b2c3'});
    runCode({siteKey: 'ot_abcdefghijklmnopqrstuvwxyz012345'});

    assertThat(urls).hasLength(2);
    assertApi('gtmOnFailure').wasNotCalled();
- name: Invalid keys load nothing and fail the tag
  code: |-
    const invalidKeys = [
      undefined,
      '',
      'OT_AB12CD34',
      'ot_AB12cd34',
      ' ot_ab12cd34',
      'ot_ab12cd34 ',
      'ot_ab12',
      'ot_abcdefghijklmnopqrstuvwxyz0123456',
      'xx_ab12cd34',
      'ot-ab12cd34',
      'ot_ab12cd34"><script>',
      'ot_ab12-cd34',
      'ot_ab12_cd34'
    ];
    for (let i = 0; i < invalidKeys.length; i++) {
      runCode({siteKey: invalidKeys[i]});
    }

    assertApi('setInWindow').wasNotCalled();
    assertApi('injectScript').wasNotCalled();
    assertApi('gtmOnSuccess').wasNotCalled();
    assertApi('gtmOnFailure').wasCalled();
- name: Script load error fails the tag
  code: |-
    mock('injectScript', function(url, onSuccess, onFailure, cacheToken) {
      onFailure();
    });

    runCode({siteKey: 'ot_ab12cd34'});

    assertApi('gtmOnSuccess').wasNotCalled();
    assertApi('gtmOnFailure').wasCalled();
setup: ''


